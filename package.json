  "type": "module",
  "license": "AGPL-3.0-or-later",
  "description": "Neko-console - a lightweight, zero-dependency web console for Linux servers: metrics, processes, systemd services, logs and files.",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "server",
    "console",
    "monitoring",
    "systemd",
    "linux",
    "react",
    "tailwindcss"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baizi51676-source/neko-console.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node server/main.mjs",
    "init": "node server/init.mjs",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.72.0",
    "motion": "^14.13.0",
