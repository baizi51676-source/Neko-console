# Neko-console systemd unit
#
# Install:
#   sudo cp deploy/neko-console.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now neko-console
#
# Logs: journalctl -u neko-console -f

[Unit]
Description=Neko-console - server web console
Documentation=https://github.com/baizi51676-source/neko-console
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Dedicated unprivileged account created by deploy/install.sh.
User=neko
Group=neko
WorkingDirectory=/opt/neko-console
ExecStart=/usr/bin/env node server/main.mjs

Restart=on-failure
RestartSec=5s

# --- hardening ---
# The service only needs to read system state and the file root, plus control
# units via systemctl. Everything else is denied.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Writable paths: the file manager root and nothing else.
ReadWritePaths=/var/lib/neko-console
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true

# --- capabilities ---
# systemctl talks to the systemd socket, which needs no special capability for
# read operations; restarting units requires the polkit rule installed by
# deploy/install.sh (see deploy/polkit.rules). Without that rule, start/stop will
# be rejected — the UI surfaces the error rather than failing silently.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

# --- environment ---
Environment=NODE_ENV=production
Environment=NEKO_CONFIG_DIR=/etc/neko-console
# Bind to loopback by default and put a TLS reverse proxy in front. Set
# NEKO_HOST=0.0.0.0 only if the console is on a trusted network.
Environment=NEKO_HOST=127.0.0.1
Environment=NEKO_PORT=8737

# --- limits ---
# The console streams metrics and reads logs; these caps stop a runaway query
# from exhausting the host.
LimitNOFILE=8192
MemoryMax=512M
TasksMax=256

[Install]
WantedBy=multi-user.target
