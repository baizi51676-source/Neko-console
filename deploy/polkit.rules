// polkit rule: allow the `neko` service user to control systemd units.
//
// Scoped deliberately narrow:
//   - only the manage-units action
//   - only lifecycle verbs (start/stop/restart/reload)
//   - nothing else is granted
//
// Install to /etc/polkit-1/rules.d/49-neko-console.rules and reload polkit.
// Delete this file to make service control read-only.
polkit.addRule(function (action, subject) {
  if (subject.user != "neko") return;

  if (action.id != "org.freedesktop.systemd1.manage-units") return;

  var verb = action.lookup("verb");
  var allowed = ["start", "stop", "restart", "reload"];
  if (verb && allowed.indexOf(verb) == -1) return;

  return polkit.Result.YES;
});
